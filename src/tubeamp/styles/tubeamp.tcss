/* TubeAmp — Themeable retro UI
 *
 * No literal colours here: `$background`/`$surface` come from the Textual
 * theme registered in themes.py, and anything else is painted from
 * theming.py. A hex in this file would survive every theme switch.
 */

Screen {
    background: $background;
    align: center middle;
}

/* ── Main Container ─────────────────────────────── */

#player-container {
    max-width: 86;
    width: 100%;
    border: heavy;
    background: $background;
}

/* ── Main Panel (Horizontal split: 60/40) ─────── */

#main-panel {
    height: 7;
    width: 100%;
}

/* ── Spectrum Visualizer (Left 60%) ──────────────── */

SpectrumWidget {
    width: 1fr;
    height: 7;
    background: transparent;
}

/* ── Vertical Divider ──────────────────────────── */

#panel-divider {
    width: 1;
    height: 100%;
    background: transparent;
}

/* ── Right Panel (Volume + Controls, 40%) ──────── */

#right-panel {
    width: 1fr;
    height: 7;
}

/* ── Volume Bar Widget ──────────────────────────── */

VolumeWidget {
    height: 3;
    background: transparent;
    padding: 1 1;
}

/* ── Horizontal Separators ─────────────────────── */

.section-separator {
    height: 1;
    width: 100%;
}

.panel-separator {
    height: 1;
    width: 100%;
    padding: 0 1;
}

/* ── Track Info ─────────────────────────────────── */

TrackInfoWidget {
    height: 4;
    padding: 0 1;
}

/* ── Controls ───────────────────────────────────── */

ControlsWidget {
    height: 3;
    padding: 0 1;
    align: center middle;
}

/* ── Playlist ───────────────────────────────────── */

PlaylistWidget {
    height: 1fr;
    padding: 0 1;
}
